<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SVR 2011" Width="1280" Height="850" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0B0F17" FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Base" Color="#0B0F17"/>
    <SolidColorBrush x:Key="Surface" Color="#151B27"/>
    <SolidColorBrush x:Key="Field" Color="#1C2331"/>
    <SolidColorBrush x:Key="FieldHover" Color="#252E40"/>
    <SolidColorBrush x:Key="Line" Color="#6B7589"/>
    <SolidColorBrush x:Key="Ink" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="Muted" Color="#A9B2C3"/>
    <SolidColorBrush x:Key="Accent" Color="#C8202B"/>
    <SolidColorBrush x:Key="AccentHover" Color="#D72631"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#A81A24"/>
    <FontFamily x:Key="Display">Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Help" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="0,0,0,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <!-- Two-tone rule: SmackDown blue facing Raw red, as in the game's logo. -->
    <Style x:Key="Motif" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Height" Value="4"/></Style>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
        <Border BorderBrush="White" BorderThickness="2" CornerRadius="6" Margin="-4"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="18,0"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource Field}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/><Setter Property="FontSize" Value="21"/>
      <Setter Property="Padding" Value="44,0"/><Setter Property="MinHeight" Value="56"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentPressed}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#3A4150"/><Setter Property="Foreground" Value="#C9CFDA"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Box" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource Muted}" StrokeThickness="1.6"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource FieldHover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="White"/>
      <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="Box" Width="20" Height="20" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
            <Path x:Name="Mark" Data="M 4 10 L 8 14 L 16 5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Thin scrollbar that matches the dark panel; the thumb keeps 3:1 contrast. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="{StaticResource Line}" CornerRadius="4"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Muted}"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid>
          <Border x:Name="PART_Track" Background="{StaticResource Field}" CornerRadius="3"/>
          <Border x:Name="PART_Indicator" Background="{StaticResource Ink}" CornerRadius="3" HorizontalAlignment="Left"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Key art from the player's own disc; empty until setup has copied the game files. -->
    <Image x:Name="Art" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="WWE SmackDown vs. Raw 2011 key art"/>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0F17" Offset="0.62"/><GradientStop Color="#FF0B0F17" Offset="1"/>
      </LinearGradientBrush></Rectangle.Fill>
    </Rectangle>

    <!-- First run: turn the player's own disc image into game files. -->
    <Grid x:Name="SetupView" Background="{StaticResource Base}" Visibility="Collapsed">
      <Grid MaxWidth="720" Margin="48,0" VerticalAlignment="Center" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="SmackDown vs. Raw 2011" FontFamily="{StaticResource Display}" FontSize="46"/>
          <TextBlock Text="Unofficial PC build" Foreground="{StaticResource Muted}" FontSize="18" Margin="0,4,0,18"/>
          <StackPanel Style="{StaticResource Motif}" Margin="0,0,0,34"><Rectangle Width="36" Fill="#2F6FDB"/><Rectangle Width="36" Fill="{StaticResource Accent}"/></StackPanel>
          <TextBlock Text="Set up your game files" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource Help}" FontSize="14" Margin="0,8,0,26"
                     Text="Choose your own Xbox 360 disc image (.iso) of WWE SmackDown vs. Raw 2011, USA/Europe version. The launcher checks every file against that release and copies about 5.7 GB into the gamedata folder. Your disc image is only read, never changed. This happens once."/>
          <Label Content="_Disc image" Target="{Binding ElementName=IsoPath}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="IsoPath" AutomationProperties.Name="Disc image path"/>
            <Button x:Name="Browse" Grid.Column="2" Style="{StaticResource Ghost}" Content="_Browse…"/>
          </Grid>
          <ProgressBar x:Name="SetupProgress" Height="6" Margin="0,24,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
          <TextBlock x:Name="SetupDetail" Style="{StaticResource Help}" Margin="0,8,0,0"/>
          <TextBlock x:Name="SetupStatus" Text="Choose your disc image to begin." Foreground="{StaticResource Muted}" Margin="0,18,0,16" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="Install" Style="{StaticResource Primary}" Content="_Set up game files" HorizontalAlignment="Left" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Settings open over the right side of the art so the wrestlers and logo stay in view. -->
    <Border x:Name="SettingsDrawer" Width="440" HorizontalAlignment="Right" Background="#F2151B27" Visibility="Collapsed">
      <Grid Margin="32,28,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,8,22">
          <TextBlock Text="Settings" FontFamily="{StaticResource Display}" FontSize="28" VerticalAlignment="Center"/>
          <Button x:Name="CloseSettings" Style="{StaticResource Ghost}" Content="Close" HorizontalAlignment="Right" MinHeight="36" Padding="14,0" AutomationProperties.Name="Close settings"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SettingsPanel" Margin="0,0,8,0">
            <Label Content="_Display mode" Target="{Binding ElementName=DisplayMode}"/>
            <ComboBox x:Name="DisplayMode" AutomationProperties.Name="Display mode"><ComboBoxItem Content="Borderless fullscreen" Tag="Borderless"/><ComboBoxItem Content="Windowed" Tag="Windowed"/></ComboBox>
            <Label Content="_Window size" Target="{Binding ElementName=WindowSize}" Margin="0,18,0,0"/>
            <ComboBox x:Name="WindowSize" AutomationProperties.Name="Window size"><ComboBoxItem Content="1280 × 720" Tag="1280x720"/><ComboBoxItem Content="1600 × 900" Tag="1600x900"/><ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/></ComboBox>
            <Label Content="_Internal resolution" Target="{Binding ElementName=Scale}" Margin="0,18,0,0"/>
            <ComboBox x:Name="Scale" AutomationProperties.Name="Internal resolution"><ComboBoxItem Content="1× · Native, 1280 × 720" Tag="1"/><ComboBoxItem Content="2× · Sharper (experimental)" Tag="2"/><ComboBoxItem Content="3× · Sharpest (experimental)" Tag="3"/></ComboBox>
            <TextBlock x:Name="ScaleHelp" Style="{StaticResource Help}"/>
            <Label Content="Display s_ync" Target="{Binding ElementName=Presentation}" Margin="0,18,0,0"/>
            <ComboBox x:Name="Presentation" AutomationProperties.Name="Display sync"><ComboBoxItem Content="VSync · Recommended" Tag="Fifo"/><ComboBoxItem Content="Off · Lowest latency, may tear" Tag="Immediate"/><ComboBoxItem Content="Adaptive · Mailbox (test)" Tag="Mailbox"/></ComboBox>
            <TextBlock x:Name="PresentationHelp" Style="{StaticResource Help}"/>
            <Label Content="Fra_me pacing" Target="{Binding ElementName=FramePacing}" Margin="0,18,0,0"/>
            <ComboBox x:Name="FramePacing" AutomationProperties.Name="Frame pacing"><ComboBoxItem Content="Automatic · Recommended" Tag="Auto"/><ComboBoxItem Content="Match game timing" Tag="Game"/><ComboBoxItem Content="Even 60 Hz" Tag="Even"/></ComboBox>
            <TextBlock x:Name="FramePacingHelp" Style="{StaticResource Help}"/>
            <Label Content="_Controller support" Target="{Binding ElementName=Controller}" Margin="0,18,0,0"/>
            <ComboBox x:Name="Controller" AutomationProperties.Name="Controller support"><ComboBoxItem Content="Automatic · Most controllers" Tag="Auto"/><ComboBoxItem Content="Xbox compatibility · XInput" Tag="Xbox"/></ComboBox>
            <TextBlock Style="{StaticResource Help}" Text="Connect your controller before starting. Player slots are assigned automatically."/>
            <CheckBox x:Name="PerfCapture" Content="Record _frame timings for bug reports" Margin="0,22,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
          <Button x:Name="Save" Style="{StaticResource Ghost}" Content="_Save settings" Margin="0,0,10,0"/>
          <Button x:Name="Reset" Style="{StaticResource Ghost}" Content="_Restore defaults"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The one decision on this screen: Play. -->
    <Border x:Name="PlayView" Grid.Row="1" Background="{StaticResource Base}" Padding="48,0,48,28">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Style="{StaticResource Motif}" Margin="0,0,0,22" Grid.ColumnSpan="2"><Rectangle Width="36" Fill="#2F6FDB"/><Rectangle Width="36" Fill="{StaticResource Accent}"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock x:Name="Status" Text="Ready." FontSize="15" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="BuildLabel" Text="Unofficial PC build" Style="{StaticResource Help}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsToggle" Style="{StaticResource Ghost}" Content="Se_ttings" Margin="0,0,10,0"/>
          <Button x:Name="Report" Style="{StaticResource Ghost}" Content="_Bug report" Margin="0,0,10,0"/>
          <Button x:Name="Logs" Style="{StaticResource Ghost}" Content="_Logs" Margin="0,0,20,0"/>
          <Button x:Name="Play" Style="{StaticResource Primary}" Content="_Play" MinWidth="200"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
