+          ui_paints_[2].exchange(0, std::memory_order_relaxed),
+          ui_paints_[3].exchange(0, std::memory_order_relaxed));
+      presents = repeated_vblanks = 0;
+      interval_sum_ms = interval_square_sum_ms = interval_max_ms = 0.0;
+      window_start = now;
+    }
+  }
+}
