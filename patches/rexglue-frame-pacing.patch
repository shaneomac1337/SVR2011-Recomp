+void Presenter::OnGuestVblank(std::chrono::steady_clock::time_point vblank_time) {
+  {
+    std::lock_guard<std::mutex> lock(guest_output_pacing_mutex_);
+    if (!guest_output_pacing_thread_.joinable()) {
